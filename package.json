{
  "name": "stoker",
  "version": "1.0.0",
  "description": "Claude Code 로컬 트랜스크립트 기반 사용량·비용 모니터 (Stoker)",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "stoker": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js --serve",
    "build": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "wt:new": "scripts/worktree.sh new",
    "wt:list": "scripts/worktree.sh list",
    "wt:rm": "scripts/worktree.sh rm",
    "wt:clean": "scripts/worktree.sh clean",
    "app": "electron electron/main.js",
    "app:pack": "electron-builder --dir",
    "app:dist": "electron-builder",
    "icons": "node build/make-tray-icon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.duksang.stoker",
    "productName": "Stoker",
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "icon": "build/icon.png"
  }
}
